[Unit]
Description=Consistent Chicago ADU bot backup
After=adu-bot.service

[Service]
Type=oneshot
User=adu-bot
Group=adu-bot
StateDirectory=adu-bot
WorkingDirectory=/var/lib/adu-bot
ExecStart=/usr/local/libexec/adu-bot-backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
